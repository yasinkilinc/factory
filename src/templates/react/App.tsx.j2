import React from 'react';
import { BrowserRouter as Router, Routes, Route, Link } from 'react-router-dom';
import { Layout, Menu } from 'lucide-react';

{% for module in spec.modules %}
{% for entity in module.entities %}
import { {{ entity.name }}Page } from './pages/{{ entity.name }}Page';
{% endfor %}
{% endfor %}

const App: React.FC = () => {
  return (
    <Router>
      <div className="min-h-screen bg-gray-50 flex">
        {/* Sidebar */}
        <aside className="w-64 bg-white border-r border-gray-200">
          <div className="p-6">
            <h1 className="text-xl font-bold text-gray-800">{{ spec.project.name }}</h1>
          </div>
          <nav className="mt-6">
            {% for module in spec.modules %}
            <div className="px-6 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
              {{ module.name }}
            </div>
            {% for entity in module.entities %}
            <Link 
              to="/{{ entity.name | lower }}" 
              className="flex items-center px-6 py-3 text-gray-600 hover:bg-gray-100 transition-colors"
            >
              <Layout size={18} className="mr-3" />
              {{ entity.name }}
            </Link>
            {% endfor %}
            {% endfor %}
          </nav>
        </aside>

        {/* Main Content */}
        <main className="flex-1 overflow-auto">
          <Routes>
            <Route path="/" element={<div className="p-8"><h2 className="text-2xl font-bold">Welcome to {{ spec.project.name }}</h2></div>} />
            {% for module in spec.modules %}
            {% for entity in module.entities %}
            <Route path="/{{ entity.name | lower }}/*" element={<{{ entity.name }}Page />} />
            {% endfor %}
            {% endfor %}
          </Routes>
        </main>
      </div>
    </Router>
  );
};

export default App;
