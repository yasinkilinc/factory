"""
Routes for {{ module.name }} module
"""

from fastapi import APIRouter, HTTPException, status
from typing import List
from uuid import UUID

from .models import {% for entity in module.entities %}{{ entity.name }}, {{ entity.name }}Create, {{ entity.name }}Update{% if not loop.last %}, {% endif %}{% endfor %}

from .services import {% for entity in module.entities %}{{ entity.name.lower() }}_service{% if not loop.last %}, {% endif %}{% endfor %}


router = APIRouter()

{% for entity in module.entities %}

@router.get("/{{ entity.name.lower() }}", response_model=List[{{ entity.name }}])
async def get_all_{{ entity.name.lower() }}():
    """Get all {{ entity.name }} entities"""
    return {{ entity.name.lower() }}_service.get_all()


@router.get("/{{ entity.name.lower() }}/{id}", response_model={{ entity.name }})
async def get_{{ entity.name.lower() }}(id: UUID):
    """Get {{ entity.name }} by ID"""
    item = {{ entity.name.lower() }}_service.get_by_id(id)
    if not item:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="{{ entity.name }} not found"
        )
    return item


@router.post("/{{ entity.name.lower() }}", response_model={{ entity.name }}, status_code=status.HTTP_201_CREATED)
async def create_{{ entity.name.lower() }}(data: {{ entity.name }}Create):
    """Create new {{ entity.name }}"""
    return {{ entity.name.lower() }}_service.create(data)


@router.put("/{{ entity.name.lower() }}/{id}", response_model={{ entity.name }})
async def update_{{ entity.name.lower() }}(id: UUID, data: {{ entity.name }}Update):
    """Update {{ entity.name }}"""
    item = {{ entity.name.lower() }}_service.update(id, data)
    if not item:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="{{ entity.name }} not found"
        )
    return item


@router.delete("/{{ entity.name.lower() }}/{id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_{{ entity.name.lower() }}(id: UUID):
    """Delete {{ entity.name }}"""
    if not {{ entity.name.lower() }}_service.delete(id):
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="{{ entity.name }} not found"
        )

{% endfor %}
