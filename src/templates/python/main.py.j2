"""
{{ project.name }}
{{ project.description or 'Generated by Backend Factory' }}
"""

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
{% for module in modules %}
from {{ module.name }}.routes import router as {{ module.name }}_router
{% endfor %}

app = FastAPI(
    title="{{ project.name }}",
    description="{{ project.description or 'Generated by Backend Factory' }}",
    version="{{ project.version }}"
)

# CORS
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Register routers
{% for module in modules %}
app.include_router({{ module.name }}_router, prefix="/{{ module.name }}", tags=["{{ module.name }}"])
{% endfor %}

@app.get("/")
async def root():
    return {"message": "{{ project.name }} API", "version": "{{ project.version }}"}

@app.get("/health")
async def health():
    return {"status": "healthy"}


if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port={{ project.port }})
